#!/bin/sh
# ============================================================
# Schutz vor versehentlichem Commit vertraulicher Daten.
# Aktiv durch:  git config core.hooksPath .githooks
# Notfall-Umgehung (bewusst!):  git commit --no-verify
# ============================================================
set -u

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

bad=""
for f in $staged; do
  case "$f" in
    privat/*|*/privat/*) bad="$bad $f" ;;
    *.csv)               bad="$bad $f" ;;
    accounts*|kontakte*) bad="$bad $f" ;;
    nachrichten.html|zettel.html|whatsapp-versand.html) bad="$bad $f" ;;
    daten.json|*-export.json|stufenkasse-export*.json)  bad="$bad $f" ;;
    .env|.env.*)         [ "$f" = ".env.example" ] || bad="$bad $f" ;;
    *.pem|*.key)         bad="$bad $f" ;;
    supabase/.temp/*)    bad="$bad $f" ;;
  esac
done

if [ -n "$bad" ]; then
  echo ""
  echo "COMMIT GESTOPPT - vertrauliche Dateien im Commit:"
  for f in $bad; do echo "   - $f"; done
  echo ""
  echo "Personenbezogene Daten gehoeren nach privat/ (ignoriert), nie ins Repo."
  echo "Wieder entfernen mit:  git restore --staged <datei>"
  exit 1
fi

# Inhaltspruefung: Secrets im Diff (Service-Role-Key, JWT, VAPID-Private, Passwortspalten)
# Gesucht werden echte Secret-WERTE, nicht das blosse Wort (sonst blockieren
# harmlose Kommentare/SQL, in denen "service_role" vorkommt).
if git diff --cached -U0 | grep -nE \
   'eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}|sb_secret_[A-Za-z0-9]|SERVICE_ROLE[A-Z_]*["'"'"'= ]+[A-Za-z0-9._-]{20,}|VAPID_PRIVATE[A-Z_]*["'"'"'= ]+[A-Za-z0-9._-]{20,}' >/dev/null; then
  echo ""
  echo "COMMIT GESTOPPT - der Diff enthaelt etwas, das nach einem Secret aussieht"
  echo "(Service-Role-Key, JWT oder VAPID-Private-Key)."
  echo "Pruefen mit:  git diff --cached"
  exit 1
fi

exit 0
